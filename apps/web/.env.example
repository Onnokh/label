# Server-side only. Vite never puts an unprefixed variable in the browser
# bundle, and this must not reach it.
#
# The secret the API knows as INTERNAL_RENDER_TOKEN. A Server-Side Render of a
# public page states it, so a render is left out of the Public Profile Rate
# Limit and a visitor who opens a page always gets the page. Keep this the same
# value as apps/api/.env.
INTERNAL_RENDER_TOKEN=local-render-token
