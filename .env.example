# Postgres
POSTGRES_PASSWORD=change-me

# Better Auth
BETTER_AUTH_SECRET=replace-with-32-char-random-string
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

APPLE_CLIENT_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=
APPLE_APP_BUNDLE_IDENTIFIER=app.sleevy

# Public URLs (Coolify sets SERVICE_URL_* automatically from each service's
# configured domain; override locally if needed)
SERVICE_URL_API=http://localhost:3002
SERVICE_URL_WEB=http://localhost:8080

# IndexNow (optional). Generate with: openssl rand -hex 16
# This value is publicly served at https://sleevy.app/<key>.txt so IndexNow can
# verify domain ownership; it is an ownership-verification token, not a secret.
INDEXNOW_KEY=

# AI (optional)
AI_ENABLED=false
AI_PROVIDER=
AI_MODEL=

# Public Profile cache purging (optional). The token should be dedicated to
# Zone > Cache Purge > Purge by cache tags and kept in deployment secrets.
CLOUDFLARE_ZONE_ID=
CLOUDFLARE_CACHE_PURGE_API_TOKEN=

# Analytics (Rybbit, optional, server-side only)
# RYBBIT_API_URL and RYBBIT_SITE_ID are non-secret. Set RYBBIT_API_KEY only in
# real environments (Coolify secrets / local .env) — never commit a real key.
RYBBIT_ENABLED=false
RYBBIT_API_URL=https://rybbit.missingmounts.com
RYBBIT_SITE_ID=c8631725ed4a
RYBBIT_API_KEY=

# Analytics (Rybbit, optional, marketing site client-side)
# The web Docker build exposes the non-secret RYBBIT_SITE_ID above to the browser.
# VITE_RYBBIT_SCRIPT_SRC is baked into the web build and can override the default.
VITE_RYBBIT_SCRIPT_SRC=https://rybbit.missingmounts.com/api/script.js
